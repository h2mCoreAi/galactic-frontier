# Example environment configuration for Galactic Frontier backend
# Copy this file to .env and customize values for your environment.
# Do NOT commit real secrets.

NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://user:pass@localhost:5432/galactic
JWT_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me
DISCORD_CLIENT_ID=replace_me
DISCORD_CLIENT_SECRET=replace_me
FRONTEND_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5174
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOG_LEVEL=debug
SUBSCRIPTIONS_ENABLED=false
AUTH_BYPASS=true
# AI_PROVIDER=local
# MOCK_EMAIL=true
# MOCK_PAYMENTS=true